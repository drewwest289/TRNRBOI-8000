# ── Express API server (server/index.js) ──────────────────────────────────────
# Copy this file to .env for local overrides (it is gitignored).
# On Render, set these in the service dashboard or via render.yaml.

# Port the server listens on.
# Render injects PORT automatically — this default is used in local dev only.
PORT=3001

# Directory where pending.json (the Apple Watch workout queue) is written.
# Local dev: leave unset — defaults to server/ directory.
# Render:    set to /tmp (working dir is read-only in prod).
# QUEUE_DIR=/tmp

# Comma-separated list of CORS-allowed origins.
# Add your Cloudflare Pages URL once you have it.
# Example: CORS_ORIGINS=http://localhost:5173,https://your-app.pages.dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173


# ── Supabase (server/index.js) ───────────────────────────────────────────────
# Supabase dashboard → Settings → API
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Auth (server/index.js) ────────────────────────────────────────────────────
# Any long random string — used to sign/verify JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=your_secret_here
# Full URL of the frontend — the server redirects here after OAuth with ?token=
# JWT_SECRET=your_secret_here
# FRONTEND_URL=http://localhost:5173

# ── Strava API (server/index.js) ─────────────────────────────────────────────
# Get these from https://www.strava.com/settings/api after creating your app.
# Set them in Render's dashboard (Environment tab) — never commit real values.
# STRAVA_CLIENT_ID=your_client_id
# STRAVA_CLIENT_SECRET=your_client_secret
# The callback URL must match exactly what you entered as "Authorization Callback Domain"
# on the Strava API settings page. Include the full path.
# STRAVA_REDIRECT_URI=https://your-app.onrender.com/auth/strava/callback
#
# Token persistence — so tokens survive Render redeploys:
# RENDER_API_KEY:    Render dashboard → Account Settings → API Keys → Create API Key
# RENDER_SERVICE_ID: the srv-xxxxx ID in your service URL (e.g. srv-abc123def456)
# RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxx
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxxxxxxx
#
# The three below are written automatically by the server after OAuth — do not set them by hand.
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=
# STRAVA_TOKEN_EXPIRES_AT=


# ── Vite dev server (vite.config.js) ──────────────────────────────────────────

# API proxy target for the Vite dev server.
# Leave unset in local dev — defaults to http://localhost:3001.
# This has no effect on the production build; see the Cloudflare Pages section below.
# VITE_API_URL=http://localhost:3001


# ── Cloudflare Pages (set in the Pages dashboard, not in this file) ───────────

# The URL of your deployed Render service — used by the Pages Function
# at functions/api/[[path]].js to proxy /api/* requests to Render.
# Set this in: Cloudflare Pages → Settings → Environment variables
# RENDER_API_URL=https://half-marathon-api.onrender.com
